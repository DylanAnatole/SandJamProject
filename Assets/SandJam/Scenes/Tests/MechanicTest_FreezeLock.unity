  m_Script: {fileID: 11500000, guid: f8756dadd4780804ebb421cc6c43d9fb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  SceneTitle: "Test: \u0110\xF3ng b\u0103ng + \u1ED4 kh\xF3a"
  Levels:
  - Title: "\u0110\xF3ng b\u0103ng"
    LevelId: 112x84_AnimalPortrait_1
    Rule: "Kh\u1ED1i b\u1ECDc b\u0103ng hi\u1EC7n s\u1ED1. M\u1ED7i l\u1EA7n \u0111\u01B0a
      kh\u1ED1i kh\xE1c l\xEAn \xF4 ch\u1EDD, s\u1ED1 gi\u1EA3m 1 (\u0111\u01B0a
      c\u1EB7p n\u1ED1i l\xEAn gi\u1EA3m 2). V\u1EC1 0 b\u0103ng v\u1EE1 v\xE0 kh\u1ED1i
      ch\u1ECDn \u0111\u01B0\u1EE3c."
  - Title: "\u0110\xF3ng b\u0103ng (2)"
    LevelId: 112x84_AnimalPortrait_10
    Rule: "Nhi\u1EC1u kh\u1ED1i \u0111\xF3ng b\u0103ng; \u01B0u ti\xEAn ch\u1ECDn
      kh\u1ED1i kh\xE1c \u0111\u1EC3 ph\xE1 b\u0103ng."
  - Title: "\u1ED4 kh\xF3a"
    LevelId: 112x84_Halloween_1
    Rule: "V\xF9ng s\u1ECDc c\xF3 \u1ED5 kh\xF3a v\xE0 s\u1ED1. Ch\u1EC9 kh\u1ED1i
      c\xF3 CH\xCCA KH\xD3A (c\xF9ng m\xE0u) m\u1EDBi b\u1EAFn v\xE0o \u1ED5 kh\xF3a.
      S\u1ED1 v\u1EC1 0 th\xEC \u1ED5 kh\xF3a v\u1EE1, v\xF9ng m\u1EDF v\xE0 kh\u1ED1i
      th\u01B0\u1EDDng t\xF4 v\xE0o."
  - Title: "\u1ED4 kh\xF3a (2)"
    LevelId: 112x84_ModernPosters_1
    Rule: "\u1ED4 kh\xF3a trong tranh kh\xE1c; kh\u1ED1i ch\xECa kh\xF3a kh\xF4ng
      t\xF4 v\xF9ng th\u01B0\u1EDDng."
