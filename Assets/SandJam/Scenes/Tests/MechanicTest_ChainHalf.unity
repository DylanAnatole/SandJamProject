  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f8756dadd4780804ebb421cc6c43d9fb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  SceneTitle: "Test: Kh\u1ED1i n\u1ED1i + N\u1EEDa kh\u1ED1i"
  Levels:
  - Title: "N\u1ED1i d\u1ECDc"
    LevelId: 112x84_Accessories_2
    Rule: "Hai kh\u1ED1i c\xF3 d\xE2y n\u1ED1i li\u1EC1n nhau trong c\xF9ng h\xE0ng
      \u0111\u01B0\u1EE3c ch\u1ECDn c\xF9ng l\xFAc v\xE0 l\xEAn hai \xF4 ch\u1EDD
      c\u1EA1nh nhau. C\u1EA7n \u0111\u1EE7 2 \xF4 tr\u1ED1ng li\u1EC1n k\u1EC1."
  - Title: "N\u1ED1i d\u1ECDc (2)"
    LevelId: 112x84_Accessories_5
    Rule: "Nh\u01B0 tr\xEAn: ch\u1ECDn kh\u1ED1i tr\xEAn ho\u1EB7c kh\u1ED1i d\u01B0\u1EDBi
      \u0111\u1EC1u k\xE9o c\u1EA3 c\u1EB7p l\xEAn."
  - Title: "N\u1ED1i ngang"
    LevelId: 112x84_AnimalPortrait_11
    Rule: "C\u1EB7p n\u1ED1i n\u1EB1m \u1EDF hai h\xE0ng c\u1EA1nh nhau c\xF9ng v\u1ECB
      tr\xED. Ch\u1EC9 ch\u1ECDn \u0111\u01B0\u1EE3c khi c\u1EA3 hai c\xF9ng \u1EDF
      \u0111\u1EA7u h\xE0ng; l\xEAn \xF4 ch\u1EDD c\xF9ng nhau."
  - Title: "N\u1ED1i ngang (2)"
    LevelId: 112x84_AnimalPortrait_14
    Rule: "C\u1EB7p n\u1ED1i ngang k\u1EBFt h\u1EE3p kh\u1ED1i \u0111\xF3ng b\u0103ng."
  - Title: "N\u1EEDa kh\u1ED1i"
    LevelId: 112x84_EventFigures_1
    Rule: "Kh\u1ED1i h\xECnh n\xEAm l\xE0 m\u1ED9t n\u1EEDa. L\xEAn \xF4 ch\u1EDD
      th\xEC NG\u1EE6 (zzz) v\xE0 kh\xF4ng b\u1EAFn. Khi m\u1ED9t n\u1EEDa C\xD9NG
      M\xC0U kh\xE1c l\xEAn \xF4 ch\u1EDD, hai n\u1EEDa gh\xE9p th\xE0nh m\u1ED9t
      kh\u1ED1i \u0111\u1EA7y (c\u1ED9ng l\u01B0\u1EE3ng c\xE1t) r\u1ED3i b\u1EAFn."
  - Title: "N\u1EEDa kh\u1ED1i (2)"
    LevelId: 112x84_EventFigures_11
    Rule: "N\u1EEDa kh\xE1c m\xE0u kh\xF4ng gh\xE9p \u0111\u01B0\u1EE3c; \u0111\u1EC3
      qu\xE1 nhi\u1EC1u n\u1EEDa ng\u1EE7 s\u1EBD h\u1EBFt ch\u1ED7."
