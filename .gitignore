# Content taken from the original game (Voodoo) stays local: decompiled code, ripped assets,
# original configs/scenes, and every Resources subfolder (sprites, audio, levels, configs).
/SourceData/
/OriginalReference/
/Assets/RecoveredOriginal/
/Assets/RecoveredOriginal.meta
/Assets/SandJam/Assets/Resources/*/
/Assets/SandJam/Assets/Resources/*.meta
!/Assets/SandJam/Assets/Resources/*.shader.meta
!/Assets/SandJam/Assets/Resources/Inter.ttf.meta
!/Assets/SandJam/Assets/Resources/LilitaOne-Regular.ttf.meta
# Levels designed for this project (not from the original game) are kept.
!/Assets/SandJam/Assets/Resources/CustomLevels/
!/Assets/SandJam/Assets/Resources/CustomLevels.meta
/Assets/SandJam/Assets/Resources/Tutorial.json
# Prefabs and ScriptableObjects loaded by Resources path are built from original content: local only.
/Assets/SandJam/Prefabs/Resources/
/Assets/SandJam/Prefabs/Resources.meta
/Assets/SandJam/ScriptableObjects/Resources/
/Assets/SandJam/ScriptableObjects/Resources.meta
/recovered-assets-*.log
# Data derived from the original levels/art: region meshes, picture previews, level JSON copies,
# meshes/poses extracted from the original, and screenshots showing the original pictures.
/Assets/SandJam/Assets/Generated/**/PaintalbePart_*
/Assets/SandJam/Assets/Generated/**/Region_*
/Assets/SandJam/Assets/Generated/**/Obstacles.asset*
/Assets/SandJam/Assets/Generated/**/*BoardPreview.png*
/Assets/SandJam/Assets/Generated/**/*Playable.json*
/Assets/SandJam/Assets/Generated/**/Original*
/Documentation/**/*.png
/Documentation/**/*.jpg

# Prefab built from the original character rig (bone hierarchy of the original game): local only.
/Assets/SandJam/Prefabs/Characters/SandCube.prefab
/Assets/SandJam/Prefabs/Characters/SandCube.prefab.meta

# Editor tooling from a third party (Unity MCP bridge used while developing), not part of the game: local only.
/Packages/com.coplaydev.unity-mcp/
# Indexes and notes about the content extracted from the original game (decompiled script list, ripped asset map,
# original level inventory, copied-file hashes, original palette, original class architecture): local only.
/Documentation/EXTRACTED_SCRIPT_INDEX.csv
/Documentation/RECOVERED_ASSET_INDEX.csv
/Documentation/LEVEL_DATA_INVENTORY.csv
/Documentation/ORIGINAL_CONTENT_VALIDATION.json
/Documentation/RECOVERY_LIMITATIONS.json
/Documentation/ORIGINAL_CONTENT_VI.md
/Documentation/KIEN_TRUC_GOC_VA_THIET_KE_VI.md
/Documentation/**/copied-assets.csv
/Documentation/**/animation-sources.csv
/Documentation/ReferenceUI/folders.csv
/Documentation/VideoUI/palette.json
# Raw test run outputs (results are summarised in NHAT_KY_TIEN_DO_VI.md).
/Documentation/**/*.txt
